{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bckgrnd-msc/contracts/performance.json",
  "$comment": "A performance recording, version 2 (docs/PERFORMANCE_EVENTS.md). The state the performer started from (`initial`), then only the actions the engine applied, each at the engine step and onset it applied on. A standalone document: a take exports as its own file and is never part of a project, a snapshot or a project export. Written by frontend/lib/recording.ts. Kept to the JSON Schema subset frontend/lib/take-schema.ts validates (the app and the tools share it): type, const, enum, required, properties, additionalProperties, minimum, maximum, maxItems, items, oneOf, $ref.",
  "title": "bckgrnd-msc performance recording",
  "type": "object",
  "required": ["format", "version", "track", "bpm", "stepsPerBar", "recordedAt", "startedAtStep", "stoppedBy", "truncated", "events"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "bckgrnd-msc/performance" },
    "version": {
      "const": 2,
      "$comment": "2: onsets, Beat Repeat, fill length, recordedAt. A v2 reader refuses version 1 (never exported, no onsets) and any newer version."
    },
    "track": { "type": "string", "$comment": "The track id the take was recorded on. A track change ends the take." },
    "bpm": { "type": "number", "minimum": 1, "$comment": "Tempo when Record was pressed. Positions are musical, so tempo changes do not move them." },
    "stepsPerBar": { "const": 16 },
    "recordedAt": { "type": "string", "$comment": "When Record was pressed, ISO 8601 UTC. A label for the file, never a position." },
    "startedAtStep": {
      "type": "integer",
      "minimum": -1,
      "maximum": 255,
      "$comment": "The song step sounding when Record was pressed; -1 if no step had sounded yet (stopped, or before Play's first onset)."
    },
    "stoppedBy": { "enum": [null, "user", "stop", "panic", "track", "mix", "cap"] },
    "truncated": { "type": "boolean", "$comment": "True when the 10,000-event cap ended the take." },
    "initial": { "$ref": "#/$defs/initial" },
    "events": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "reservedKinds": {
      "$comment": "Kinds a later version may add (filter and echo holds, other gestures). A v2 reader refuses them; a v2 writer never writes them.",
      "enum": ["filter", "echo", "gesture"]
    },
    "event": {
      "oneOf": [
        { "$ref": "#/$defs/scene" },
        { "$ref": "#/$defs/fill" },
        { "$ref": "#/$defs/rise" },
        { "$ref": "#/$defs/fillInto" },
        { "$ref": "#/$defs/repeat" }
      ]
    },
    "seq": { "type": "integer", "minimum": 1 },
    "requestId": { "type": "integer", "minimum": 1 },
    "step": { "type": "integer", "minimum": 0, "maximum": 255 },
    "bar": { "type": "integer", "minimum": 1, "maximum": 16 },
    "beat": { "type": "integer", "minimum": 1, "maximum": 4 },
    "sixteenth": { "type": "integer", "minimum": 1, "maximum": 4 },
    "offGrid": { "const": true },
    "slot": { "enum": ["full", "sparse", "build", "drop"] },
    "scene": {
      "type": "object",
      "required": ["seq", "kind", "requestId", "step", "bar", "beat", "sixteenth", "onset", "pass", "slot", "name", "timing", "crash"],
      "additionalProperties": false,
      "properties": {
        "seq": { "$ref": "#/$defs/seq" },
        "kind": { "const": "scene" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "step": { "$ref": "#/$defs/step" },
        "bar": { "$ref": "#/$defs/bar" },
        "beat": { "$ref": "#/$defs/beat" },
        "sixteenth": { "$ref": "#/$defs/sixteenth" },
        "onset": { "$ref": "#/$defs/onset" },
        "pass": { "$ref": "#/$defs/pass" },
        "offGrid": { "$ref": "#/$defs/offGrid" },
        "slot": { "$ref": "#/$defs/slot" },
        "name": { "type": "string" },
        "timing": { "enum": ["now", "beat", "bar"] },
        "crash": { "type": "boolean" }
      }
    },
    "fill": {
      "type": "object",
      "required": ["seq", "kind", "requestId", "step", "bar", "beat", "sixteenth", "onset", "pass", "style", "length", "phraseBars", "link", "outcome"],
      "additionalProperties": false,
      "properties": {
        "seq": { "$ref": "#/$defs/seq" },
        "kind": { "const": "fill" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "step": { "$ref": "#/$defs/step" },
        "bar": { "$ref": "#/$defs/bar" },
        "beat": { "$ref": "#/$defs/beat" },
        "sixteenth": { "$ref": "#/$defs/sixteenth" },
        "onset": { "$ref": "#/$defs/onset" },
        "pass": { "$ref": "#/$defs/pass" },
        "offGrid": { "$ref": "#/$defs/offGrid" },
        "style": { "type": ["string", "null"] },
        "length": { "$ref": "#/$defs/fillLength" },
        "phraseBars": { "enum": [0, 2, 4, 8, 16] },
        "link": { "enum": ["none", "fillInto", "rise"] },
        "partner": { "$ref": "#/$defs/requestId" },
        "outcome": { "enum": ["played", "cutShort", "open"] },
        "endStep": { "$ref": "#/$defs/step" },
        "endOnset": { "$ref": "#/$defs/onset" },
        "reason": { "type": "integer", "minimum": 1 }
      }
    },
    "rise": {
      "type": "object",
      "required": ["seq", "kind", "requestId", "step", "bar", "beat", "sixteenth", "onset", "pass", "slot", "name", "bars", "withFill", "outcome", "crash"],
      "additionalProperties": false,
      "properties": {
        "seq": { "$ref": "#/$defs/seq" },
        "kind": { "const": "rise" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "step": { "$ref": "#/$defs/step" },
        "bar": { "$ref": "#/$defs/bar" },
        "beat": { "$ref": "#/$defs/beat" },
        "sixteenth": { "$ref": "#/$defs/sixteenth" },
        "onset": { "$ref": "#/$defs/onset" },
        "pass": { "$ref": "#/$defs/pass" },
        "offGrid": { "$ref": "#/$defs/offGrid" },
        "slot": { "$ref": "#/$defs/slot" },
        "name": { "type": "string" },
        "bars": { "enum": [2, 4, 8] },
        "withFill": { "type": "boolean" },
        "fillRequestId": { "$ref": "#/$defs/requestId" },
        "outcome": { "enum": ["landed", "cancelled", "replaced", "open"] },
        "endStep": { "$ref": "#/$defs/step" },
        "endOnset": { "$ref": "#/$defs/onset" },
        "reason": { "type": "integer", "minimum": 1 },
        "crash": { "type": "boolean" }
      }
    },
    "fillInto": {
      "type": "object",
      "required": ["seq", "kind", "requestId", "step", "bar", "beat", "sixteenth", "onset", "pass", "slot", "name", "fillRequestId", "length", "crash"],
      "additionalProperties": false,
      "properties": {
        "seq": { "$ref": "#/$defs/seq" },
        "kind": { "const": "fillInto" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "step": { "$ref": "#/$defs/step" },
        "bar": { "$ref": "#/$defs/bar" },
        "beat": { "$ref": "#/$defs/beat" },
        "sixteenth": { "$ref": "#/$defs/sixteenth" },
        "onset": { "$ref": "#/$defs/onset" },
        "pass": { "$ref": "#/$defs/pass" },
        "offGrid": { "$ref": "#/$defs/offGrid" },
        "slot": { "$ref": "#/$defs/slot" },
        "name": { "type": "string" },
        "fillRequestId": { "$ref": "#/$defs/requestId" },
        "length": { "$ref": "#/$defs/fillLength" },
        "crash": { "type": "boolean" }
      }
    },
    "onset": {
      "type": "integer",
      "minimum": 0,
      "$comment": "Onsets since the take's first event (0): the engine's monotonic onset serial less the first event's. Never wraps or jumps."
    },
    "pass": {
      "type": "integer",
      "minimum": 1,
      "$comment": "1-based run through the song, for people: +1 per wrap, at least +1 across a loop, cue or seek since the event before. A label; onset is the position."
    },
    "fillLength": { "enum": ["bar", "beat"], "$comment": "The effective length the fill played: the bar, or only its last beat." },
    "repeat": {
      "$comment": "A Beat Repeat that engaged (event 61) and where it ended (event 62, a recapture, or the take's stop). A press released before its grid line never engaged and is not here.",
      "type": "object",
      "required": ["seq", "kind", "token", "step", "bar", "beat", "sixteenth", "onset", "pass", "division", "endedBy"],
      "additionalProperties": false,
      "properties": {
        "seq": { "$ref": "#/$defs/seq" },
        "kind": { "const": "repeat" },
        "token": { "type": "integer", "minimum": 1, "$comment": "The gesture token: session-local, one hold. Not a request id." },
        "step": { "$ref": "#/$defs/step" },
        "bar": { "$ref": "#/$defs/bar" },
        "beat": { "$ref": "#/$defs/beat" },
        "sixteenth": { "$ref": "#/$defs/sixteenth" },
        "onset": { "$ref": "#/$defs/onset" },
        "pass": { "$ref": "#/$defs/pass" },
        "offGrid": { "$ref": "#/$defs/offGrid" },
        "division": { "enum": [4, 8, 16] },
        "endedBy": {
          "enum": ["engine", "recapture", "take", "open"],
          "$comment": "engine: event 62; recapture: the same hold captured again, the next repeat with this token carries on; take: the take stopped while held, closed at the stop; open: still held, in a take still recording."
        },
        "endStep": { "$ref": "#/$defs/step" },
        "endOnset": { "$ref": "#/$defs/onset" },
        "reason": { "type": "integer", "minimum": 0, "$comment": "Event 62's reason code (engine only)." }
      }
    },
    "stemSettings": {
      "type": "object",
      "$comment": "Always written in full; a reader requires none and accepts stem parameters it does not know.",
      "properties": {
        "volume": { "type": "number", "minimum": 0, "maximum": 1 },
        "send": { "type": "number", "minimum": 0, "maximum": 1 },
        "muted": { "type": "boolean" },
        "solo": { "type": "boolean" }
      }
    },
    "initial": {
      "$comment": "What the performer started from when Record was pressed. Optional for a reader (a v2 take may lack it); a v2 writer always writes it. Never a project: nothing here is saved into one.",
      "type": "object",
      "required": ["track", "bpm", "swing", "scene", "mix", "fill", "repeatDivision", "loopBars"],
      "additionalProperties": false,
      "properties": {
        "track": { "type": "string" },
        "bpm": { "type": "number", "minimum": 40, "maximum": 200 },
        "swing": { "type": "number", "minimum": 0, "maximum": 1 },
        "scene": {
          "type": "object",
          "required": ["slot", "modified"],
          "additionalProperties": false,
          "properties": {
            "slot": { "enum": [null, "full", "sparse", "build", "drop"], "$comment": "The active scene slot, or null when none is active." },
            "modified": { "type": "boolean", "$comment": "The mix had moved away from the active scene." }
          }
        },
        "mix": {
          "type": "object",
          "required": ["params", "stems"],
          "additionalProperties": false,
          "properties": {
            "params": {
              "$comment": "Every contracts/parameters.json parameter, by id. A toggle is 0 or 1. Always written in full; a reader requires none and accepts ids it does not know, so a take still opens after a parameter is added or removed (opening is view only).",
              "type": "object",
              "properties": {
                "transport.bpm": { "type": "number", "minimum": 40, "maximum": 200 },
                "transport.swing": { "type": "number", "minimum": 0, "maximum": 1 },
                "master.level": { "type": "number", "minimum": 0, "maximum": 1 },
                "fx.low": { "type": "number", "minimum": 0, "maximum": 1.4 },
                "fx.mid": { "type": "number", "minimum": 0, "maximum": 1.4 },
                "fx.high": { "type": "number", "minimum": 0, "maximum": 1.4 },
                "fx.filter": { "type": "number", "minimum": 0, "maximum": 1 },
                "fx.stereo": { "type": "number", "minimum": 0, "maximum": 1 },
                "fx.filterQ": { "type": "number", "minimum": 0.5, "maximum": 6 },
                "fx.echoFeedback": { "type": "number", "minimum": 0, "maximum": 0.9 },
                "fx.echoReturn": { "type": "number", "minimum": 0, "maximum": 1 },
                "fx.reverbMix": { "type": "number", "minimum": 0, "maximum": 0.5 },
                "fx.reverbDecay": { "type": "number", "minimum": 0.2, "maximum": 2.5 },
                "fx.width": { "type": "number", "minimum": 0, "maximum": 1.5 },
                "fx.echoTime": { "type": "number" },
                "performance.loopBars": { "type": "number" },
                "performance.echoThrow": { "enum": [0, 1] }
              }
            },
            "stems": {
              "$comment": "Every stem's contracts/parameters.json stem parameters. Always written in full; a reader requires none and accepts stems it does not know, so a take still opens after a stem is added or removed (opening is view only).",
              "type": "object",
              "properties": {
                "kick": { "$ref": "#/$defs/stemSettings" },
                "clap": { "$ref": "#/$defs/stemSettings" },
                "hats": { "$ref": "#/$defs/stemSettings" },
                "bass": { "$ref": "#/$defs/stemSettings" },
                "stab": { "$ref": "#/$defs/stemSettings" },
                "lead": { "$ref": "#/$defs/stemSettings" },
                "pad": { "$ref": "#/$defs/stemSettings" },
                "arp": { "$ref": "#/$defs/stemSettings" }
              }
            }
          }
        },
        "fill": {
          "type": "object",
          "required": ["style", "length"],
          "additionalProperties": false,
          "properties": {
            "style": { "type": "string", "$comment": "The Fill style menu's choice: a style, or random or rotate." },
            "length": { "$ref": "#/$defs/fillLength", "$comment": "What a press would play: the effective length." }
          }
        },
        "repeatDivision": { "enum": [4, 8, 16] },
        "loopBars": { "type": "integer", "minimum": 0, "$comment": "The loop in bars, 0 for none; the same as mix.params['performance.loopBars']." }
      }
    }
  }
}
