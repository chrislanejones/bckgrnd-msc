{
  "$comment": "The parameter registry. One entry per control the engine exposes. Read by the UI (frontend/lib/contract.ts), by PHP (App\\Support\\Project\\Contract) and, from Night 6, by bckgrnd-msc-mcp. Add a parameter here before adding its control. See contracts/README.md.",
  "contract": "bckgrnd-msc/parameters",
  "version": 1,
  "stems": ["kick", "clap", "hats", "bass", "stab", "lead", "pad", "arp"],
  "parameters": [
    {
      "id": "transport.bpm",
      "label": "Tempo",
      "kind": "continuous",
      "min": 40,
      "max": 200,
      "step": 1,
      "control": { "min": 60, "max": 180 },
      "default": "track",
      "unit": "bpm",
      "scope": "project",
      "engine": "bpm"
    },
    {
      "id": "transport.swing",
      "label": "Swing",
      "kind": "continuous",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "default": "track",
      "unit": "ratio",
      "scope": "project",
      "engine": "swing"
    },
    {
      "id": "master.level",
      "label": "Master",
      "kind": "continuous",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "default": 0.78,
      "unit": "gain",
      "scope": "project",
      "engine": "master"
    },
    {
      "id": "fx.low",
      "label": "Low",
      "kind": "continuous",
      "min": 0,
      "max": 1.4,
      "step": 0.01,
      "default": 1,
      "unit": "gain",
      "scope": "project",
      "engine": "bands"
    },
    {
      "id": "fx.mid",
      "label": "Mid",
      "kind": "continuous",
      "min": 0,
      "max": 1.4,
      "step": 0.01,
      "default": 1,
      "unit": "gain",
      "scope": "project",
      "engine": "bands"
    },
    {
      "id": "fx.high",
      "label": "High",
      "kind": "continuous",
      "min": 0,
      "max": 1.4,
      "step": 0.01,
      "default": 1,
      "unit": "gain",
      "scope": "project",
      "engine": "bands"
    },
    {
      "id": "fx.filter",
      "label": "Filter",
      "kind": "continuous",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "default": 1,
      "unit": "ratio",
      "scope": "project",
      "engine": "filter"
    },
    {
      "id": "fx.stereo",
      "label": "Stereo",
      "kind": "continuous",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "default": 0.5,
      "unit": "balance",
      "scope": "project",
      "engine": "stereoBalance"
    },
    {
      "id": "fx.echoTime",
      "label": "Echo time",
      "kind": "enum",
      "options": [
        { "value": 0, "label": "Off" },
        { "value": 0.25, "label": "1/16" },
        { "value": 0.3333333333333333, "label": "1/8T" },
        { "value": 0.5, "label": "1/8" },
        { "value": 0.75, "label": "1/8." },
        { "value": 1, "label": "1/4" },
        { "value": 1.5, "label": "1/4." }
      ],
      "default": 0.75,
      "unit": "beats",
      "scope": "project",
      "engine": "echoTime"
    },
    {
      "id": "performance.loopBars",
      "label": "Loop",
      "kind": "enum",
      "options": [
        { "value": 0, "label": "Off" },
        { "value": 1, "label": "1" },
        { "value": 2, "label": "2" },
        { "value": 4, "label": "4" },
        { "value": 8, "label": "8" },
        { "value": 16, "label": "16" }
      ],
      "default": 0,
      "unit": "bars",
      "scope": "performance",
      "engine": "loop"
    },
    {
      "id": "performance.echoThrow",
      "label": "Echo throw",
      "kind": "toggle",
      "default": false,
      "unit": "on",
      "scope": "performance",
      "engine": "echo"
    }
  ],
  "stemParameters": [
    {
      "id": "volume",
      "label": "Volume",
      "kind": "continuous",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "default": "track",
      "unit": "gain",
      "scope": "project",
      "engine": "volume"
    },
    {
      "id": "muted",
      "label": "Cut",
      "kind": "toggle",
      "default": false,
      "unit": "on",
      "scope": "project",
      "engine": "mute"
    },
    {
      "id": "solo",
      "label": "Solo",
      "kind": "toggle",
      "default": false,
      "unit": "on",
      "scope": "project",
      "engine": "solo"
    }
  ]
}
