# Dependencies
/node_modules
/vendor
/.pnpm-store

# Build output. Regenerated by `pnpm run build`; the wasm and the worklet bundle
# are build products, so they are not committed.
/public/build
/public/wasm
/public/hot

# Laravel
# Unanchored on purpose. The leading slash in `/.env*` only ever matched at the
# repo root, so floor-desktop/.env stayed tracked and carried an APP_KEY into
# the first commit.
.env*
/storage/*.key
/storage/presets/*.json

# Rust
/engine-core/target

# Playwright
/test-results
/playwright-report

# Editors and OS
.DS_Store
.idea
.vscode
*.swp
# Laravel runtime caches and logs, all regenerated.
/storage/framework/cache
/storage/framework/sessions
/storage/framework/testing
/storage/framework/views
/storage/logs
/dist
.netlify
/public/index.html
