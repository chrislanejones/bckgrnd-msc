# Dependencies
/node_modules
/vendor
/.pnpm-store

# Build output. Regenerated by `pnpm run build`; the wasm and the worklet bundle
# are build products, so they are not committed.
/public/build
/public/wasm
/public/hot
# The static variation catalog, generated by `pnpm run build:static`.
/public/library/variations

# Laravel
# Unanchored on purpose. The leading slash in `/.env*` only ever matched at the
# repo root, so floor-desktop/.env stayed tracked and carried an APP_KEY into
# the first commit.
.env*
/storage/*.key
/storage/presets/*.json

# Rust
/engine-core/target

# Playwright
/test-results
/playwright-report

# Editors and OS
.DS_Store
.idea
.vscode
*.swp
# Laravel runtime caches and logs, all regenerated. The folders themselves are kept
# (a .gitkeep each): `php artisan serve` answers 500 ("Please provide a valid cache
# path") in a fresh clone or worktree without them.
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
!/storage/framework/cache/.gitkeep
!/storage/framework/sessions/.gitkeep
!/storage/framework/views/.gitkeep
/storage/framework/testing
/storage/logs
/dist
.netlify
/public/index.html

# PHPUnit
/.phpunit.result.cache
/.phpunit.cache
/public/shared
/public/build-manifest.json
/build
/nativephp/electron
/database/*.sqlite*
/bootstrap/cache/*.php
/storage/app

/nativephp/binaries
