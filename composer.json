{
    "name": "bckgrnd-msc/desktop",
    "type": "project",
    "description": "bckgrnd-msc — a stem machine. Laravel + NativePHP shell with a Rust/WASM audio engine.",
    "keywords": [
        "laravel",
        "nativephp",
        "audio",
        "daw",
        "wasm"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4.1",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.10",
        "nativephp/desktop": "^2.4"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "build:engine": "pnpm run build:engine",
        "build:assets": "pnpm run build",
        "build": [
            "@build:engine",
            "@build:assets",
            "@native:install"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "pnpm exec concurrently -k -c \"#93c5fd,#c4b5fd\" -n \"vite,artisan\" \"pnpm run dev\" \"php artisan serve --host=127.0.0.1 --port=8080\""
        ],
        "dev:desktop": [
            "@php artisan native:run --installer=pnpm"
        ],
        "test": [
            "@test:php",
            "@test:rust",
            "@test:parity",
            "@test:arrangement",
            "@test:contract",
            "@test:scenes",
            "@test:editing",
            "@test:audio",
            "@test:ui",
            "@test:editor"
        ],
        "test:php": "@php vendor/bin/phpunit",
        "test:rust": "cargo test --manifest-path engine-core/Cargo.toml",
        "test:parity": "@php tools/compare-with-original.php tools/reference.json",
        "test:audio": "pnpm run verify:audio",
        "test:ui": "pnpm run verify:ui",
        "test:editor": "pnpm run verify:editor",
        "test:arrangement": "@php tools/check-arrangement.php",
        "test:contract": "node tools/check-contract.mjs",
        "test:scenes": "node tools/check-scenes.mjs",
        "test:editing": "node tools/check-editing.mjs",
        "build:library": "@php tools/export-library.php public/library",
        "native:dev": [
            "@dev:desktop"
        ],
        "native:install": "node scripts/install-native.mjs"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
