{
  "name": "bckgrnd-msc",
  "private": true,
  "type": "module",
  "description": "bckgrnd-msc \u2014 stem machine UI. Vite + React, rendering into the NativePHP webview.",
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:engine": "node scripts/build-engine.mjs",
    "build:worklet": "node scripts/build-worklet.mjs",
    "build:app": "node scripts/build-shared.mjs && node scripts/build-manifest.mjs && vite build",
    "build:app:static": "node scripts/build-app-static.mjs",
    "build": "pnpm run build:worklet && pnpm run build:app",
    "build:static": "node scripts/build-static.mjs",
    "build:all": "pnpm run build && pnpm run build:static",
    "build:netlify": "pnpm run build:engine && pnpm run build && pnpm run build:static",
    "typecheck": "tsc --noEmit",
    "verify:audio": "node tools/verify-audio.mjs",
    "verify:static": "node tools/verify-static.mjs",
    "serve": "php artisan serve --host=0.0.0.0 --port=8080",
    "serve:static": "node tools/serve-dist.mjs 8090 0.0.0.0",
    "dev": "pnpm exec concurrently -k \"node scripts/build-worklet.mjs --watch\" \"vite\"",
    "verify:ui": "node tools/verify-ui.mjs",
    "verify:editor": "node tools/verify-editor.mjs",
    "check:contract": "node tools/check-contract.mjs",
    "check:scenes": "node tools/check-scenes.mjs",
    "check:editing": "node tools/check-editing.mjs",
    "verify:projects": "node tools/verify-projects.mjs",
    "build:shared": "node scripts/build-shared.mjs",
    "check:dist": "node tools/check-dist.mjs",
    "verify:web": "node tools/verify-suite.mjs web",
    "verify:desktop": "node tools/verify-suite.mjs desktop"
  },
  "dependencies": {
    "lucide-react": "^0.510.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.5",
    "esbuild": "^0.25.12",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
