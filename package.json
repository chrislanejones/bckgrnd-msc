{
  "name": "bckgrnd-msc",
  "private": true,
  "type": "module",
  "description": "bckgrnd-msc \u2014 stem machine UI. Vite + React, rendering into the NativePHP webview.",
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:engine": "cd engine-core && wasm-pack build --target web --release --out-dir ../public/wasm",
    "build:worklet": "node scripts/build-worklet.mjs",
    "build:app": "vite build",
    "build:app:static": "VITE_STATIC=1 vite build --mode static",
    "build": "pnpm run build:worklet && pnpm run build:app",
    "build:static": "node scripts/build-static.mjs",
    "build:all": "pnpm run build && pnpm run build:static",
    "build:netlify": "pnpm run build:engine && pnpm run build && pnpm run build:static",
    "typecheck": "tsc --noEmit",
    "verify:audio": "node tools/verify-audio.mjs",
    "verify:static": "node tools/verify-static.mjs",
    "serve": "php artisan serve --host=0.0.0.0 --port=8080",
    "serve:static": "php -S 0.0.0.0:8090 -t public",
    "dev": "pnpm run build:worklet --watch & vite"
  },
  "dependencies": {
    "lucide-react": "^0.510.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.62.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "concurrently": "^9.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
