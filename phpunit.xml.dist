<?xml version="1.0" encoding="UTF-8"?>
<!--
  The PHP gate: the song form, the API the app reads, the static export, and the
  project contract. Run with `composer test:php` or `php artisan test`.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
         beStrictAboutOutputDuringTests="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_DEBUG" value="false"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="LOG_CHANNEL" value="null"/>
        <env name="BCKGRND_PRESET_DISK" value="local"/>
    </php>
</phpunit>
